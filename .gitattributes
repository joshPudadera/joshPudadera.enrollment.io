# Normalize line endings to LF on commit
* text=auto eol=lf

# Keep CRLF for Windows-specific files
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files — don't touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.zip   binary
*.gz    binary
