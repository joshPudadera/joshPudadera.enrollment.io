# Normalize all text files to LF on commit (Linux server compatible)
* text=auto eol=lf

# Explicitly set PHP, JS, CSS, HTML, Python to LF
*.php  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.py   text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.env  text eol=lf
*.txt  text eol=lf
*.xml  text eol=lf

# Binary files — no line ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.docx binary
*.xlsx binary
