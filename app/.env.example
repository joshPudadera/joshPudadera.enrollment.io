# BCP Student Management System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-api-key-here

# ── Database (override for hosted environments) ──────────────
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=
# DB_NAME=sms_db

# ── App base URL (no trailing slash) ─────────────────────────
# Used when generating links (e.g. password reset emails).
# Set to your live domain when deploying.
APP_URL=https://enrollment.bcpsms2.com

# ── SMTP Email (required for approval emails) ─────────────────
# Gmail: enable 2FA, then generate an App Password at
#   https://myaccount.google.com/apppasswords
# Other providers: use their SMTP hostname and credentials.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPT=tls
MAIL_USER=you@gmail.com
MAIL_PASS=your-app-password-here
MAIL_FROM_NAME=BCP Student Portal
