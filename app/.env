# BCP Student Management System — Environment Variables
# ─────────────────────────────────────────────────────────────
# NEVER commit this file to version control with real credentials.
# For hosted environments, set these as server environment variables
# in your hosting control panel instead of storing them here.

# ── OpenAI ───────────────────────────────────────────────────
# Set AI_API in your hosting control panel (recommended),
# or fill it in here for local development only.
AI_API=your-openai-api-key-here

# ── Database ─────────────────────────────────────────────────
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=
# DB_NAME=sms_db

# ── App base URL (no trailing slash) ─────────────────────────
# Set to your live domain when deploying.
# Leave blank to auto-detect from HTTP_HOST.
APP_URL=https://bcpsms.online

# ── SMTP Email ────────────────────────────────────────────────
# Used for MFA codes and approval emails.
#
# RECOMMENDED: set MAIL_HOST, MAIL_PORT, MAIL_USER, MAIL_PASS,
# MAIL_ENCRYPT, MAIL_FROM_NAME as server environment variables
# in your hosting control panel so credentials are never in files.
#
# Gmail App Password setup:
#   1. Enable 2-Step Verification on the Gmail account
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Generate a password — paste it as MAIL_PASS (spaces OK)
#
# If port 587 is blocked by your host, use port 465 + ssl instead:
#   MAIL_PORT=465
#   MAIL_ENCRYPT=ssl
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPT=ssl
MAIL_USER=enrollment.systembcp@gmail.com
MAIL_PASS=your-gmail-app-password-here
MAIL_FROM_NAME=BCP Student Portal
