# BCP Student Management System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── OpenAI ───────────────────────────────────────────────────
# Key is read from environment variable AI_API.
# Set AI_API in your hosting control panel, or set it here for local dev.
AI_API=your-openai-api-key-here
# ── Database (override for hosted environments) ──────────────
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=
# DB_NAME=sms_db

# ── App base URL (no trailing slash) ─────────────────────────
# Used when generating links (e.g. password reset emails).
#
# LOCAL development:
#   APP_URL=http://localhost/sms/app
#
# HOSTED / production (update before uploading):
#   APP_URL=https://yourdomain.com/app
#   — or if the app is at the domain root —
#   APP_URL=https://yourdomain.com
#
# If APP_URL is left blank the system auto-detects it from the
# request host and DOCUMENT_ROOT. Set it explicitly on shared
# hosting to avoid incorrect URL generation.
APP_URL=https://bcpsms.online

# ── SMTP Email (required for approval emails + MFA codes) ─────
# Gmail with App Password works on most hosts.
# If port 587 (STARTTLS) is blocked by your host, try port 465 (SSL):
#   MAIL_PORT=465
#   MAIL_ENCRYPT=ssl
#
# Common hosting SMTP issue: some providers block outbound port 587.
# Solution: use port 465 + ssl, OR use your host's own SMTP relay.
#
# To get a Gmail App Password:
#   1. Enable 2-Step Verification on the Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Generate a password for "Mail" — use it here (spaces don't matter)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPT=tls
MAIL_USER=enrollment.systembcp@gmail.com
MAIL_PASS=xyzu wzrq mazz tysq
MAIL_FROM_NAME=BCP Student Portal
