# BCP Student Management System — Environment Variables
# ─────────────────────────────────────────────────────────────
# NEVER commit this file to version control with real credentials.
# For hosted environments, set these as server environment variables
# in your hosting control panel instead of storing them here.

# ── OpenAI ───────────────────────────────────────────────────
# Set AI_API in your hosting control panel (recommended),
# or fill it in here for local development only.
AI_API=your-openai-api-key-here

# ── External API Token ────────────────────────────────────────
# Used to authenticate requests to /api/
# Set a long random secret — e.g. openssl rand -hex 32
# Keep this private and never commit the real value.
API_TOKEN=change-this-to-a-secure-random-token

# ── API Test — inter-system student transfer ──────────────────
# URL of Page 2's receive endpoint (Page 1 sends TO this).
API_TEST2_RECEIVE_URL=http://enrollment.bcpsms2/sms/app/api/test2_receive.php

# URL of Page 1's receive endpoint (Page 2 sends TO this).
API_TEST1_RECEIVE_URL=http://enrollment.bcpsms2/sms/app/api/test1_receive.php

# URL of Page 1's send endpoint (Page 2 calls this to pull from Page 1).
API_TEST1_SEND_URL=http://enrollment.bcpsms2/sms/app/api/test1_send.php

# URL of Page 2's send endpoint (Page 1 calls this to pull from Page 2).
API_TEST2_SEND_URL=http://enrollment.bcpsms2/sms/app/api/test2_send.php

# Shared secret token — both systems must have the same value.
API_TEST_TOKEN=apitest2026token

# Database names for the two test systems
API_TEST1_DB=api_test1
API_TEST2_DB=api_test2

# DB credentials for the test databases (can differ from sms_db)
API_TEST_DB_HOST=127.0.0.1
API_TEST_DB_USER=root
API_TEST_DB_PASS=

# ── External System Integration ───────────────────────────────
# URL of the receiving endpoint on the external system.
# When a student is assigned an ID, their data is POSTed here automatically.
# Example: EXTERNAL_API_URL=http://logistics2/api/receive_students.php
# Leave blank to disable auto-send.
EXTERNAL_API_URL=

# ── Database ─────────────────────────────────────────────────
# DB_HOST=localhost
# DB_USER=root
# DB_PASS=
# DB_NAME=sms_db

# ── App base URL (no trailing slash) ─────────────────────────
# Set to your live domain when deploying.
# Leave blank to auto-detect from HTTP_HOST.
APP_URL=https://bcpsms.online

# ── MFA (Two-Step Verification for admin/staff login) ─────────
# Set to true to enable MFA — a 6-digit code is emailed on login.
# Set to false to skip MFA entirely (useful for local testing).
# Re-enable before going live: MFA_ENABLED=true
MFA_ENABLED=false

# ── SMTP Email ────────────────────────────────────────────────
# Used for MFA codes and approval emails.
#
# RECOMMENDED: set MAIL_HOST, MAIL_PORT, MAIL_USER, MAIL_PASS,
# MAIL_ENCRYPT, MAIL_FROM_NAME as server environment variables
# in your hosting control panel so credentials are never in files.
#
# Gmail App Password setup:
#   1. Enable 2-Step Verification on the Gmail account
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Generate a password — paste it as MAIL_PASS (spaces OK)
#
# If port 587 is blocked by your host, use port 465 + ssl instead:
#   MAIL_PORT=465
#   MAIL_ENCRYPT=ssl
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPT=ssl
MAIL_USER=enrollment.systembcp@gmail.com
MAIL_PASS=your-gmail-app-password-here
MAIL_FROM_NAME=BCP Student Portal
